{
  "manifest_version": 3,
  "name": "Closer reply drafter",
  "version": "0.3.0",
  "description": "Drafts replies to buyer messages from your Closer listing. Independent tool, not affiliated with any marketplace.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3100/*",
    "https://closer-9a91.onrender.com/*",
    "https://www.facebook.com/messages/*",
    "https://www.kijiji.ca/m-msg-my-messages/*",
    "https://www.facebook.com/marketplace/*",
    "https://www.facebook.com/commerce/listing/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Closer"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3100/demo/marketplace*",
        "https://closer-9a91.onrender.com/demo/marketplace*",
        "https://www.facebook.com/messages/*",
        "https://www.kijiji.ca/m-msg-my-messages/*"
      ],
      "js": [
        "selectors.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3100/dashboard*",
        "https://closer-9a91.onrender.com/dashboard*"
      ],
      "js": [
        "pair.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.facebook.com/marketplace/*",
        "https://www.facebook.com/commerce/listing/*"
      ],
      "js": [
        "selectors.js",
        "listing.js",
        "post.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
